# Functions

# Shared function for fuzzy finding directories
_fzf_find_dir() {
  local cache="${XDG_CACHE_HOME:-$HOME/.cache}/fzf_dirs"
  local ttl=3600
  mkdir -p "${cache:h}"
  _fzf_find_dir_build() {
    fd -t d --hidden --exclude .git --exclude node_modules --exclude .Trash \
       --min-depth 1 --max-depth 5 . "$HOME" \
      | awk '{print length, $0}' | sort -n | cut -d' ' -f2- > "$1.tmp" \
      && mv "$1.tmp" "$1"
  }
  [ -s "$cache" ] || _fzf_find_dir_build "$cache"
  local age=$(( $(date +%s) - $(stat -f %m "$cache" 2>/dev/null || stat -c %Y "$cache") ))
  [ "$age" -ge "$ttl" ] && (_fzf_find_dir_build "$cache" &) >/dev/null 2>&1
  fzf --tmux --no-sort --preview="tree -I '.git' -Cl -L 1 {}" < "$cache"
}

alias nv='result=$(_fzf_find_dir) && [ -n "$result" ] && cd "$result" && nvim "$result"'
alias cdz='result=$(_fzf_find_dir) && [ -n "$result" ] && cd "$result"'

alias ll="ls -larth"
alias python="python3"
alias gc="mkdir -p ~/git && cd ~/git && git clone "

dug() {
  local pattern="$1"
  shift
  until "$@" 2>&1 | tee /dev/tty | grep -q "$pattern"; do
    echo "────────────────────────────────────────"
    sleep 1
  done
}

fzg() {
  local base="${1:-$HOME}"

  : | fzf --ansi \
      --delimiter ':' \
      --preview '[[ -n {1} ]] && (bat --color=always --highlight-line {2} {1} 2>/dev/null || rg --color=always --smart-case --hidden --context 5 {q} {1})' \
      --preview-window=bottom:60%:+{2}-5 \
      --bind 'change:reload:[ -n {q} ] && rg --column --line-number --no-heading --color=always --smart-case --hidden --glob "!**/.git/**" --glob "!**/Library/Application Support/Code/**" --glob "!**/.claude" --glob "!**/.bash_history" --glob "!**/.zsh_history" {q} '"$base"' || true' \
      --print-query |
  awk -F: 'NR==2 {print $1}'
}
